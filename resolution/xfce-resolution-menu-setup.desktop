[Desktop Entry]
Version=1.0
Type=Application
Name=Resolution menu setup
Comment=Add the resolution menu to the XFCE panel once per user
Exec=xfce-resolution-menu-setup --auto
Terminal=false
NoDisplay=true
OnlyShowIn=XFCE;
