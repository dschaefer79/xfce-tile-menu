[Desktop Entry]
Version=1.0
Type=Application
Name=Quit
Comment=Remove the Tiling menu from the panel (Window Tiling Menu in the applications menu puts it back)
Icon=application-exit
Exec=xfce-tile-menu-setup --remove
Terminal=false
StartupNotify=false
