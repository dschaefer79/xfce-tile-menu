[Desktop Entry]
Version=1.0
Type=Application
Name=Keyboard shortcuts…
Comment=Set keyboard shortcuts for tiling
Icon=preferences-desktop-keyboard-shortcuts
Exec=xfce-tile-settings --shortcuts
Terminal=false
StartupNotify=true
