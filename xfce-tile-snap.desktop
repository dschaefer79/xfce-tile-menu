[Desktop Entry]
Version=1.0
Type=Application
Name=Window snapping
Comment=Snap dropped and new windows into columns or rows (set in Window Tiling settings)
Exec=xfce-tile snap-daemon
Terminal=false
NoDisplay=true
OnlyShowIn=XFCE;
